#!/bin/bash
# Mirror ServeTracker field photos / uploads to Cloudflare R2 (incremental by size).
# Litestream only protects the database; the uploads directory lives on the same 9p
# filesystem and can lose recently written files across a container restart.
# Silent on success (cron watchdog pattern); prints on failure.
set -uo pipefail
ENVF=/etc/zo/litestream-prod.env
[ -f "$ENVF" ] || { echo "uploads-sync: missing $ENVF"; exit 1; }
set -a; . "$ENVF"; set +a
export AWS_ACCESS_KEY_ID="${LITESTREAM_ACCESS_KEY_ID}" AWS_SECRET_ACCESS_KEY="${LITESTREAM_SECRET_ACCESS_KEY}"
SRC="${UPLOADS_SRC:-/home/workspace/Projects/PDFUSAEDIT-zo/data/uploads}"
PREFIX="${UPLOADS_PREFIX:-uploads-prod}"
LOG=/dev/shm/uploads-sync.log
out=$(timeout 600 /usr/local/bin/aws --endpoint-url "$LITESTREAM_ENDPOINT" s3 sync "$SRC" \
        "s3://${LITESTREAM_BUCKET}/${PREFIX}/" --size-only --only-show-errors 2>&1)
rc=$?
printf '%s rc=%s %s\n' "$(date -u +%FT%TZ)" "$rc" "$(printf '%s' "$out" | tail -c 400)" >> "$LOG"
if [ "$rc" != "0" ]; then
  echo "uploads-sync FAILED (rc=$rc): $(printf '%s' "$out" | tail -c 300)"
  exit 1
fi
exit 0
