#!/bin/bash
# ServeTracker prod app boot wrapper: recover from R2 if needed, report the measured 9p
# durability loss window, then start the server.
# Used as the `servetracker-proc` supervisor command so recovery always happens first.
set -uo pipefail
cd /home/workspace/Projects/PDFUSAEDIT-zo || exit 1
# Best effort, never blocks startup for more than a few seconds.
timeout 330 /usr/local/bin/servetracker-restore-from-r2 || echo "[boot-wrapper] restore step failed (continuing)"
# Measured loss window from the canary stamps (0s = the filesystem dropped nothing).
timeout 60 /usr/local/bin/servetracker-canary-report --always || true
exec bun server/index.ts
