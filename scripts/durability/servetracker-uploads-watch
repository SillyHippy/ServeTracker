#!/bin/bash
# Copy new ServeTracker field photos to R2 every few seconds (no bun restart).
# Never re-put keys listed in pruned-excludes.lst (Python set filter — not aws --exclude argv).
set -uo pipefail
FILTER="${UPLOADS_FILTER:-/usr/local/bin/servetracker-uploads-sync-filtered}"
[ -x "$FILTER" ] || FILTER="$(dirname "$0")/uploads-sync-filtered.py"
exec /usr/bin/python3 "$FILTER" --loop
