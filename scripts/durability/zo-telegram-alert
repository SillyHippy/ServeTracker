#!/bin/bash
# Minimal Telegram alert helper (home channel). Usage: zo-telegram-alert "message"
# Token/chat are read from env files; nothing is ever printed.
set -uo pipefail
MSG="${1:-}"
[ -n "$MSG" ] || exit 0

TOKEN=""
CHAT=""
for f in /root/.hermes/.env /home/workspace/credentials/master_keys.env /home/workspace/credentials/*.env; do
  [ -f "$f" ] || continue
  if [ -z "$TOKEN" ]; then
    v=$(grep -m1 '^TELEGRAM_BOT_TOKEN=' "$f" 2>/dev/null | cut -d= -f2- | tr -d '"'"'"' ')
    case "$v" in ''|*...*|*'<'*|*'*'*) : ;; *) TOKEN="$v" ;; esac
  fi
  if [ -z "$CHAT" ]; then
    v=$(grep -m1 '^TELEGRAM_HOME_CHANNEL=' "$f" 2>/dev/null | cut -d= -f2- | tr -d '"'"'"' ')
    case "$v" in ''|*...*) : ;; *) CHAT="$v" ;; esac
  fi
done
[ -n "$TOKEN" ] && [ -n "$CHAT" ] || { echo "zo-telegram-alert: no token/chat found" >&2; exit 1; }

curl -s -m 20 -X POST "https://api.telegram.org/bot${TOKEN}/sendMessage" \
  -d "chat_id=${CHAT}" --data-urlencode "text=${MSG}" -d "disable_web_page_preview=true" >/dev/null
exit 0
