# PDFUSAEDIT environment — for Zo deploy

# --- App login (bootstrap only; NOT a live password after admin exists) ---
# APP_PASSWORD=change-me-on-first-boot
PUBLIC_BASE_URL=https://servetracker.justlegalsolutions.org

# --- Email (Resend SMTP) ---
EMAIL_FROM=no-reply@justlegalsolutions.org
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=your_resend_smtp_password
RESEND_API_KEY=your_resend_api_key

# --- Server ---
PORT=3150
NODE_ENV=production
DATA_DIR=./data
CORS_ORIGIN=https://pdfusaedit-sillyhippy.zo.computer

# --- Vite build ---
VITE_API_URL=https://pdfusaedit-sillyhippy.zo.computer

# --- Appwrite one-time migration (npm run migrate:appwrite) ---
APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=67ff9afd003750551953
APPWRITE_API_KEY=your_appwrite_api_key
APPWRITE_DATABASE_ID=67eae6fe0020c6721531
APPWRITE_CLIENTS_COLLECTION_ID=67eae70e000c042112c8
APPWRITE_CLIENT_CASES_COLLECTION_ID=67eae98f0017c9503bee
APPWRITE_SERVE_ATTEMPTS_COLLECTION_ID=new_serve_attempts
APPWRITE_CLIENT_DOCUMENTS_COLLECTION_ID=67eaeaa900128f318514
APPWRITE_STORAGE_BUCKET_ID=67eaeb7700322d74597e
APPWRITE_THUMBNAIL_BUCKET_ID=68865532001e22527554
MIGRATE_FILES=true
DATABASE_URL=file:./data/pdfusaedit.db

# --- Optional SMS (Android SMS Gateway: https://github.com/capcom6/android-sms-gateway) ---
# Leave disabled unless you have a dedicated Android phone with a SIM.
SMS_GATEWAY_ENABLED=false
SMS_GATEWAY_API_URL=https://api.sms-gate.app/3rdparty/v1/messages
SMS_GATEWAY_USER=
SMS_GATEWAY_PASS=
SMS_GATEWAY_DEVICE_ID=

# --- Optional Email Backup (Brevo SMTP Failover) ---
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_USER=
BREVO_SMTP_KEY=

# --- Optional Helcim invoicing ---
# Leave unset to disable. Never create invoices from attach; attach is GET-only.
HELCIM_API_TOKEN=
HELCIM_WEBHOOK_SECRET=
HELCIM_MOCK=false

# --- Optional Google OAuth (Better Auth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BETTER_AUTH_SECRET=change-me-better-auth-secret
